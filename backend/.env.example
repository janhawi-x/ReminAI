# ReminAI Environment Variables

# Groq API (Speech-to-Text with Whisper & LLM Chat with Llama 3.3)
GROQ_API_KEY=YOUR_GROQ_KEY
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Firebase Admin SDK (Place serviceAccountKey.json in backend directory)
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# JWT / Security
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# App Config
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# Edge TTS Speech Voice Configuration
TTS_VOICE=en-US-JennyNeural
TTS_LANGUAGE=en

# Optional SMS Gateway (Twilio or custom webhook)
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_URL=
